{
  "manifest_version": 1,
  "id": "mnemo",
  "name": "mnemo 历史会话搜索",
  "version": "0.1.0",
  "description": "只有声明、不跑程序：跑助手的那台电脑上装了 mnemo（https://github.com/szupzj18/mnemo），Claude 助手就多一组 mcp__mnemo__* 工具，按内容搜 Claude Code、Codex 等 Agent 以前的会话，读命中处的上下文。只开只读工具，重建索引的 reindex 禁用。没装 mnemo 时什么都不加。Persona 不传凭据，也不读 mnemo 的配置。",
  "publisher": "nwverse",
  "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/mnemo",
  "tags": ["agents", "assistant", "search", "mcp"],
  "engines": {"persona": ">=202611051918"},
  "contributes": {
    "mcp_servers": [
      {
        "id": "mnemo",
        "command": "mnemo",
        "env": "PERSONA_MNEMO_BIN",
        "args": ["mcp"],
        "requires": ["mcp"],
        "allow": ["search_sessions", "get_context", "get_session", "list_recent_sessions"],
        "deny": ["reindex"]
      }
    ]
  }
}
