{
  "manifest_version": 1,
  "id": "telegram",
  "name": "Telegram",
  "version": "0.1.20",
  "description": "用你自己的 Telegram 账号（MTProto，hub 连 Telegram 的数据中心；hub 的环境设了 HTTPS_PROXY 时经它的 HTTP CONNECT 隧道）：App 里的 Telegram 会话，收件箱（私聊、@我），知识库归档，助手的 Telegram 工具和 tg 命令行。发消息、回复、转发、点 reaction、标为已读都先在手机上确认。登录（api_id、api_hash 和会话）加密存在 hub 的数据库里，不在扩展目录。",
  "publisher": "nwverse",
  "tags": ["聊天", "收件箱", "知识库"],
  "engines": {
    "persona": ">=202611041602",
    "plugin_protocol": 1
  },
  "runtime": {
    "command": {
      "linux-amd64": "bin/telegram-linux-amd64",
      "linux-arm64": "bin/telegram-linux-arm64",
      "darwin-arm64": "bin/telegram-darwin-arm64",
      "darwin-amd64": "bin/telegram-darwin-amd64"
    }
  },
  "contributes": {
    "connectors": [
      {
        "id": "telegram",
        "name": "Telegram",
        "capabilities": [
          "status",
          "tools",
          "actions",
          "events",
          "inbox",
          "archive",
          "login",
          "threads",
          "fallback"
        ],
        "unlisted": [
          "telegram_list_chats",
          "telegram_read_messages",
          "telegram_search_messages",
          "telegram_get_message",
          "telegram_get_chat",
          "telegram_list_members",
          "telegram_send",
          "telegram_forward",
          "telegram_react",
          "telegram_mark_read",
          "telegram_cli"
        ],
        "kinds": [
          "dm",
          "mention"
        ],
        "kind_descriptions": {
          "dm": "Telegram 里有人私聊用户，还没读",
          "mention": "Telegram 群里 @ 了用户，或回复了用户的消息"
        },
        "cli": "tg"
      }
    ],
    "assistant": [
      {
        "id": "telegram",
        "skills": [
          "skills/telegram"
        ]
      }
    ]
  },
  "configuration": {
    "type": "object",
    "properties": {
      "triage_rules": {
        "type": "string",
        "title": "分拣规则",
        "maxLength": 4000,
        "description": "Telegram 的条目按什么分「需要你 / 知悉即可 / 噪音」，用你自己的话写；填了就只用它（只管 Telegram）。一般不在这里改：和助手说（比如「Telegram 里陌生人的私聊都算噪音」），它来改。写 \\n 换行；空着时私聊和 @你 都算「需要你」，和以前一样"
      }
    }
  },
  "permissions": {
    "network": [
      "telegram.org",
      "*.telegram.org"
    ]
  }
}
