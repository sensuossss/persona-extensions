{
  "market_version": 1,
  "name": "nwverse 扩展",
  "description": "nwverse 维护、以后可以公开的 Persona 扩展。",
  "plugins": [
    {
      "manifest": {
        "manifest_version": 1,
        "id": "claude-bypass-allow",
        "name": "Bypass 自动允许",
        "version": "0.2.15",
        "description": "Claude Code 开着 bypassPermissions（--dangerously-skip-permissions）时，有些调用仍会弹确认框（如读工作目录外的文件、开子 Agent、某些 Bash），无人值守的 Agent 就卡在「在等你」。在你选的电脑上给 Claude Code 装一个 PermissionRequest hook：只在会话是 bypass 模式时，自动允许 Bash、只读工具（Read、Glob、Grep、LS、NotebookRead）和子 Agent。删除、覆盖数据的 Bash 命令，目标都在临时目录或工作目录里（/tmp、会话的工作目录、~/ag-work、~/wt、Claude Code 的 worktree 等）时直接放行，其余的仍然问你；打开「删除和覆盖也自动允许」就都放行。force push、改权限的 Bash 命令，写文件、Workflow 和 MCP 工具，以及你自己配的 ask / deny 规则，始终问你。每次自动允许都记一条（命令截断、去掉密钥）。别的模式照常问你。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/claude-bypass-allow",
        "engines": {
          "persona": ">=202611041602",
          "extension_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/claude-bypass-allow-linux-amd64",
            "linux-arm64": "bin/claude-bypass-allow-linux-arm64",
            "darwin-arm64": "bin/claude-bypass-allow-darwin-arm64",
            "darwin-amd64": "bin/claude-bypass-allow-darwin-amd64"
          },
          "args": [
            "hub"
          ]
        },
        "node": {
          "command": {
            "linux-amd64": "bin/claude-bypass-allow-linux-amd64",
            "linux-arm64": "bin/claude-bypass-allow-linux-arm64",
            "darwin-arm64": "bin/claude-bypass-allow-darwin-arm64",
            "darwin-amd64": "bin/claude-bypass-allow-darwin-amd64"
          },
          "args": [
            "node"
          ],
          "machines": "machines",
          "permissions": {
            "files": true
          }
        },
        "contributes": {
          "ui": [
            {
              "id": "log",
              "title": "自动允许记录",
              "placement": "extension_page"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "machines": {
              "type": "array",
              "title": "在哪些电脑上自动允许",
              "description": "打开的电脑上，Claude Code 的 settings.json 里会多一个 PermissionRequest hook；关掉、停用或卸载扩展时去掉。",
              "items": {
                "type": "string",
                "format": "machine",
                "x-os": [
                  "darwin",
                  "linux"
                ]
              },
              "x-confirm": "这台电脑上 bypass 模式的 Claude Code 会话，Bash、读文件（包括工作目录外的）和开子 Agent 的确认将不再问你、直接执行。删除、覆盖临时目录和工作目录里的东西也直接执行；别处的删除、覆盖，以及 force push、改权限仍然问你。每次都会记录。"
            },
            "allow_destructive": {
              "type": "boolean",
              "title": "删除和覆盖也自动允许",
              "description": "打开后，bypass 模式下删除、覆盖数据的 Bash 命令（rm、mv、git reset --hard、写进文件的 > 等）不管目标在哪都直接放行，包括家目录和工作目录以外的，删掉的可能找不回来。force push、改权限、格式化磁盘，以及你自己配的 ask / deny 规则仍然问你。关着时，只有目标都在临时目录、工作目录里的才放行。",
              "default": false
            },
            "config_dirs": {
              "type": "array",
              "title": "Claude Code 配置目录",
              "description": "装 hook 的目录，~ 是那台电脑的家目录。用了 CLAUDE_CONFIG_DIR 的把那个目录也加上。",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "maxItems": 8,
              "default": [
                "~/.claude"
              ]
            }
          }
        }
      },
      "tags": [
        "claude-code",
        "agents",
        "permissions"
      ],
      "packages": [
        {
          "url": "release:claude-bypass-allow-v0.2.15/claude-bypass-allow-0.2.15.tar.gz",
          "sha256": "c18e63c83273672e8a441fe451817b32c24f3040b818c2341cdf9327b4859d57",
          "size": 12165767
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "github",
        "name": "GitHub",
        "version": "0.4.13",
        "description": "GitHub 进 Persona：收件箱里是请你 review、@ 你、指派给你、你的 PR / issue 有了新评论或 review、CI 失败；和你有关的 PR、issue 归档进知识库；助手能搜、读 PR / issue、看改动和 CI，评论和 review 先在手机上确认。登录用你某台电脑上的 gh 登录或设备码登录，token 加密存在 hub 的数据库里。侧边栏的「GitHub」页：待你 review 的 PR、你的 PR 和 CI、指派 / 提到你的、通知和关注的动态、你的仓库（浏览代码、分支、README），PR 的改动文件、逐文件 diff 和行内评论、全部评论、CI 日志摘要，在这一页上评论、review、合并（先预览、确认后才发）。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/github",
        "engines": {
          "persona": ">=202611051346",
          "extension_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/github-linux-amd64",
            "linux-arm64": "bin/github-linux-arm64",
            "darwin-arm64": "bin/github-darwin-arm64",
            "darwin-amd64": "bin/github-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "github",
              "name": "GitHub",
              "capabilities": [
                "status",
                "tools",
                "actions",
                "events",
                "inbox",
                "settle",
                "archive",
                "login",
                "options",
                "threads",
                "machines",
                "fallback"
              ],
              "hosts": [
                "github.com"
              ],
              "kinds": [
                "review_requested",
                "mention",
                "team_mention",
                "assign",
                "author",
                "ci_failed"
              ],
              "kind_descriptions": {
                "assign": "GitHub 上有 issue / PR 分配给了用户",
                "author": "用户自己的 PR / issue 有了别人的新评论或 review；要用户改代码、回答问题时需要用户，LGTM、批准、机器人消息知悉即可",
                "ci_failed": "用户触发的 GitHub Actions（CI）失败了",
                "mention": "GitHub 的 PR / issue 里 @ 了用户",
                "review_requested": "GitHub 上有人请用户 review 一个 PR（用户在 reviewers 里），一般需要用户",
                "team_mention": "GitHub 上 @ 了用户所在的团队（不是用户本人），多数知悉即可"
              }
            }
          ],
          "ui": [
            {
              "id": "github",
              "title": "GitHub",
              "placement": "nav_page",
              "icon": "list"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "triage_rules": {
              "type": "string",
              "title": "分拣规则",
              "maxLength": 4000,
              "description": "GitHub的条目按什么分「需要你 / 知悉即可 / 噪音」，用你自己的话写；填了就只用它、不用收件箱的全局规则（只管GitHub）。一般不在这里改：和助手说（比如「机器人的 PR 都算噪音」），它来改。写 \\n 换行；空着用全局规则"
            },
            "inbox": {
              "type": "object",
              "title": "收件箱",
              "description": "哪些 GitHub 通知进收件箱。改了以后只影响之后新来的：已经在收件箱里的条目不删、不改；不进收件箱的也不会推送。GitHub 页面、助手的 GitHub 工具照常能看所有仓库。整个 GitHub 都不进收件箱：关掉 GitHub 连接器的「进收件箱」（这一页上，或 设置 › 连接器 › GitHub）",
              "properties": {
                "repos": {
                  "type": "array",
                  "title": "只收这些仓库",
                  "description": "写 owner/name，或 owner/* 表示这个人或组织的全部仓库，不分大小写。空着收全部仓库",
                  "maxItems": 200,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.*?-]+/[A-Za-z0-9_.*?-]+$",
                    "maxLength": 200
                  }
                },
                "exclude_repos": {
                  "type": "array",
                  "title": "不收这些仓库",
                  "description": "写法同上（owner/name 或 owner/*），在「只收这些仓库」之后再排除",
                  "maxItems": 200,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.*?-]+/[A-Za-z0-9_.*?-]+$",
                    "maxLength": 200
                  }
                },
                "skip_kinds": {
                  "type": "array",
                  "title": "不收这些类型",
                  "description": "选中的类型不进收件箱。只想让它们排得低一点、不挡掉，写在上面的分拣规则里（比如「@ 团队的都算知悉」）；CI 失败只想少收一些（只看默认分支、只看自己的 PR），在 设置 › 连接器 › GitHub 的「CI 失败」里选",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "oneOf": [
                      {
                        "const": "review_requested",
                        "title": "请你 review"
                      },
                      {
                        "const": "mention",
                        "title": "@我"
                      },
                      {
                        "const": "team_mention",
                        "title": "@了你的团队"
                      },
                      {
                        "const": "assign",
                        "title": "分配给你"
                      },
                      {
                        "const": "author",
                        "title": "你的 PR / issue 有新动静"
                      },
                      {
                        "const": "ci_failed",
                        "title": "CI 失败"
                      }
                    ]
                  }
                }
              }
            },
            "host": {
              "type": "string",
              "title": "GitHub 主机",
              "default": "github.com",
              "description": "一般不用改。GitHub Enterprise 的主机名写在这里（还没做完：现在只认 github.com）"
            },
            "proxy": {
              "type": "string",
              "title": "代理",
              "description": "hub 这台机器连不上 GitHub 时填一个 http:// 代理（http://[用户名:密码@]主机:端口），登录、API、CI 日志都走它；填错了每个请求都失败，不会绕过它直连。空着直连"
            }
          }
        },
        "permissions": {
          "network": [
            "github.com",
            "api.github.com",
            "avatars.githubusercontent.com",
            "*.actions.githubusercontent.com",
            "*.blob.core.windows.net"
          ],
          "gh_login": true
        }
      },
      "tags": [
        "开发",
        "收件箱",
        "知识库"
      ],
      "packages": [
        {
          "url": "release:github-v0.4.13/github-0.4.13.tar.gz",
          "sha256": "1a763663fd9e4f6129a1e8fffaeac9ba35458151c18503fc24ee8d2f075a6918",
          "size": 13547340
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "homeassistant",
        "name": "Home Assistant",
        "version": "0.1.6",
        "description": "接你自己的 Home Assistant：主导航上多一个「家」，按区域看设备和传感器的状态、搜索实体，点开开关灯、调亮度、调空调温度和模式、开关窗帘、执行场景，看最近 24 小时的变化；助手能查家里的状态和历史，也能操作设备（每次都在手机上确认，门锁和警戒永远要确认）。用长期访问令牌连 Home Assistant 的 REST API。",
        "publisher": "nwverse",
        "engines": {
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/homeassistant-linux-amd64",
            "linux-arm64": "bin/homeassistant-linux-arm64",
            "darwin-arm64": "bin/homeassistant-darwin-arm64",
            "darwin-amd64": "bin/homeassistant-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "homeassistant",
              "name": "Home Assistant",
              "capabilities": [
                "status",
                "tools",
                "actions"
              ],
              "confirm_always": [
                "homeassistant_secure_call"
              ]
            }
          ],
          "ui": [
            {
              "id": "home",
              "title": "家",
              "placement": "nav_page",
              "icon": "gauge"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "title": "Home Assistant 地址",
              "description": "hub 这台机器能访问到的地址，如 http://homeassistant.local:8123 或 http://<局域网地址>:8123",
              "format": "uri"
            },
            "insecure_tls": {
              "type": "boolean",
              "title": "不校验证书",
              "description": "地址是 https、用的是自签名证书时打开",
              "default": false
            },
            "writable_domains": {
              "type": "array",
              "title": "可操作的类型",
              "description": "能被操作的实体类型（domain）。不填就是常见的设备：灯、开关、风扇、窗帘、空调、播放器、扫地机、场景、脚本、门锁、警戒等；homeassistant、shell_command 这类整机和命令的永远不在里面，除非你写上",
              "items": {
                "type": "string"
              }
            },
            "hidden_areas": {
              "type": "array",
              "title": "不显示的区域",
              "description": "区域的名字或 id：页面和助手都看不到这些区域里的东西",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "secrets": [
          {
            "name": "token",
            "title": "长期访问令牌",
            "description": "在 Home Assistant 的「个人资料 › 安全 › 长期访问令牌」里新建；用管理员账号建才能按区域显示",
            "required": true
          }
        ],
        "permissions": {
          "network": []
        }
      },
      "tags": [
        "智能家居",
        "Home Assistant",
        "设备"
      ],
      "packages": [
        {
          "url": "release:homeassistant-v0.1.6/homeassistant-0.1.6.tar.gz",
          "sha256": "d2f763ece941b858f7f853c4ca62c888fe70fa6f46683eee55b6bf147cade4de",
          "size": 12870920
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "larkagentx",
        "name": "Feishu (LarkAgentX adapter)",
        "version": "0.1.5",
        "description": "独立的飞书个人账号适配器：用户自行在伴随机器上安装 LarkAgentX，hub 使用 Go 程序经 SSH 接入。只收双白名单内的文本消息，发送全文始终需要确认；不启动 Agent、不发已读回执，不替换 OpenLark。非官方协议，真实账号联调尚未验证。",
        "publisher": "nwverse",
        "homepage": "https://github.com/nwverse/persona-extensions/tree/main/extensions/larkagentx",
        "engines": {
          "persona": ">=202611041602",
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/larkagentx-linux-amd64",
            "linux-arm64": "bin/larkagentx-linux-arm64",
            "darwin-arm64": "bin/larkagentx-darwin-arm64",
            "darwin-amd64": "bin/larkagentx-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "larkagentx",
              "name": "Feishu (LarkAgentX adapter)",
              "capabilities": [
                "status",
                "login",
                "inbox",
                "events",
                "actions"
              ],
              "confirm_always": [
                "larkagentx_send_text"
              ],
              "kinds": [
                "message"
              ],
              "kind_descriptions": {
                "message": "授权会话中授权发送者发来的飞书文本消息"
              }
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "login_method": {
              "type": "string",
              "title": "登录方式",
              "enum": [
                "qr",
                "import"
              ],
              "default": "qr",
              "description": "qr 在 App 中扫码；import 通过隐藏字段导入上游登录态 JSON。"
            },
            "triage_rules": {
              "type": "string",
              "title": "分拣规则",
              "maxLength": 4000,
              "description": "飞书适配器的条目按什么分「需要你 / 知悉即可 / 噪音」；只对本扩展生效。写 \\n 换行；空着用全局规则。"
            },
            "bridge_command": {
              "type": "string",
              "title": "伴随机器命令（JSON 数组）",
              "maxLength": 8192,
              "description": "用户信任的 SSH 命令 argv；不经过本地 shell，不在参数中放凭证。见扩展文档。hub 不需要 Python。"
            },
            "allowed_chats": {
              "type": "string",
              "title": "授权会话 ID",
              "maxLength": 32768,
              "description": "逗号或换行分隔的精确 ID；不支持通配符，空白则禁止。发送也受此名单限制。"
            },
            "allowed_senders": {
              "type": "string",
              "title": "授权发送者 ID",
              "maxLength": 32768,
              "description": "逗号或换行分隔的精确 ID；收消息必须同时满足会话和发送者白名单，不接收自身回显。"
            }
          }
        }
      },
      "tags": [
        "feishu",
        "lark",
        "connector",
        "experimental"
      ],
      "packages": [
        {
          "url": "release:larkagentx-v0.1.5/larkagentx-0.1.5.tar.gz",
          "sha256": "75051b14d7e77017982d7e189ddd005fabbbe2f7ec47e506857b89cef93bf638",
          "size": 11957961
        }
      ]
    },
    {
      "manifest": {
        "manifest_version": 1,
        "id": "linuxdo",
        "name": "LINUX DO",
        "version": "0.1.10",
        "description": "LINUX DO 社区的热门帖子：扩展里的一页按你的兴趣看热门、今日 / 本周最热和最新，点开在 App 里读正文和热门回复（hub 去读，手机不用代理）；助手能用工具查热门、读帖子。只读公开内容，不用账号。",
        "publisher": "nwverse",
        "engines": {
          "plugin_protocol": 1
        },
        "runtime": {
          "command": {
            "linux-amd64": "bin/linuxdo-linux-amd64",
            "linux-arm64": "bin/linuxdo-linux-arm64",
            "darwin-arm64": "bin/linuxdo-darwin-arm64",
            "darwin-amd64": "bin/linuxdo-darwin-amd64"
          }
        },
        "contributes": {
          "connectors": [
            {
              "id": "linuxdo",
              "name": "LINUX DO",
              "capabilities": [
                "status",
                "tools"
              ],
              "hosts": [
                "linux.do"
              ]
            }
          ],
          "ui": [
            {
              "id": "hot",
              "title": "热门帖子",
              "placement": "plugin_page"
            }
          ]
        },
        "configuration": {
          "type": "object",
          "properties": {
            "list": {
              "type": "string",
              "title": "打开时看",
              "default": "hot",
              "oneOf": [
                {
                  "const": "hot",
                  "title": "热门"
                },
                {
                  "const": "daily",
                  "title": "今日最热"
                },
                {
                  "const": "weekly",
                  "title": "本周最热"
                },
                {
                  "const": "latest",
                  "title": "最新"
                }
              ]
            },
            "categories": {
              "type": "array",
              "title": "只看这些分类",
              "description": "分类名，如「开发调优」「前沿快讯」「资源荟萃」；空着看全部",
              "items": {
                "type": "string"
              }
            },
            "exclude_categories": {
              "type": "array",
              "title": "不看这些分类",
              "description": "如「搞七捻三」「跳蚤市场」",
              "items": {
                "type": "string"
              }
            },
            "keywords": {
              "type": "array",
              "title": "关键词",
              "description": "标题或摘要里有其中一个才显示（不分大小写）；空着不限",
              "items": {
                "type": "string"
              }
